<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="container" style="flex-grow: 1;">
        <ui:VisualElement name="back" style="flex-grow: 1; background-color: rgb(68, 186, 221);">
            <ui:Label text="Audio" name="title" style="color: rgb(255, 255, 255); font-size: 50px; -unity-text-align: upper-center; -unity-text-outline-color: rgba(0, 0, 0, 0); -unity-text-outline-width: 0; padding-top: 25px; padding-bottom: 25px;" />
            <ui:VisualElement name="slider-container" style="flex-grow: 1; margin-bottom: 0; margin-top: 0; padding-top: 0; margin-left: 50px; margin-right: 50px; -unity-text-align: upper-center;">
                <ui:SliderInt label="Master" value="42" high-value="100" name="master-slider" style="flex-shrink: 0; min-width: auto; width: 650px; padding-top: 10px; padding-bottom: 10px;">
                    <ui:Label text="Label" name="volume-text" />
                </ui:SliderInt>
                <ui:SliderInt label="Music" value="42" high-value="100" name="music-slider" style="flex-shrink: 0; min-width: auto; width: 650px; padding-top: 10px; padding-bottom: 10px;">
                    <ui:Label text="Label" name="volume-text" />
                </ui:SliderInt>
                <ui:SliderInt label="Sound Effect" value="42" high-value="100" name="sound-effect-slider" style="flex-shrink: 0; min-width: auto; width: 650px; padding-top: 10px; padding-bottom: 10px;">
                    <ui:Label text="Label" name="volume-text" />
                </ui:SliderInt>
            </ui:VisualElement>
            <ui:Button text="Save" name="save-btn" style="flex-shrink: 0; flex-grow: 0; align-self: center; width: 140px; height: 40px; margin-bottom: 25px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
